# Public URL used in Stripe redirect links (for example https://haven.example)
APP_ORIGIN=http://localhost:3000

# Payment provider. Development defaults to simulation; production defaults to stripe.
# Simulation is always refused when NODE_ENV=production.
PAYMENT_MODE=simulation

# Server-only credentials. Never expose these with a VITE_ prefix.
# For local Stripe Sandbox development, set its account id and use a test key.
STRIPE_SANDBOX_ACCOUNT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Separate signature secret for events from connected owner accounts.
STRIPE_CONNECT_WEBHOOK_SECRET=
RESEND_API_KEY=
# Sender verified in Resend, for example "Haven <bonjour@your-domain.fr>".
# A production deployment refuses the default Resend sandbox sender.
EMAIL_FROM=
# Inbox where recipients can reply to Haven transactional emails.
EMAIL_REPLY_TO=

# Firebase Admin uses Application Default Credentials in production.
# Locally, set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path.
GOOGLE_APPLICATION_CREDENTIALS=

# Explicit activation of the reservation lifecycle emails (default: disabled).
# Set a fixed UTC ISO timestamp when enabling, e.g. 2026-10-25T12:00:00.000Z.
# Only bookings paid from that point onward receive automated reservation emails.
# Keep this date fixed across restarts; this prevents sending old test backlogs.
RESERVATION_EMAIL_ENABLED=false
RESERVATION_EMAIL_START_AT=

# Optional recipient for the manual synthetic mail test (Resend account owner without a domain).
RESEND_TEST_EMAIL_TO=
# Use the eleven published templates in the Haven Resend account.
# Keep false until IDs and publication have been verified for your account.
RESEND_TEMPLATES_ENABLED=false
